# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<id-progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Lettura dei piani dieta con l'AI (solo sul server, mai NEXT_PUBLIC_). Facoltativa: senza, la funzione dice che non è attiva.
ANTHROPIC_API_KEY=
